---
import AppLayout from '../../layouts/AppLayout.astro';
import { formatCLP } from '../../lib/clp';
import { listCategories, listSavings } from '../../lib/data';

const user = Astro.locals.user!;
const error = Astro.url.searchParams.get('error');
let savings: Awaited<ReturnType<typeof listSavings>> = [];
let categories: Awaited<ReturnType<typeof listCategories>> = [];
try {
  savings = await listSavings(user.id);
  categories = await listCategories(user.id);
} catch {}
---
<AppLayout title="Ahorros · Lukita">
  <h1 class="mb-1 text-xl font-semibold">Ahorros</h1>
  <p class="mb-4 text-sm text-[var(--color-muted-foreground)]">
    Apartar no aumenta el saldo de la cuenta. Gastar resta cuenta y ahorro.
  </p>
  {error && <p class="mb-3 rounded-lg bg-red-500/10 px-3 py-2 text-sm text-red-600">{error}</p>}

  <div class="mb-6 space-y-2">
    {savings.length === 0 ? (
      <p class="rounded-xl border border-dashed border-[var(--color-border)] p-6 text-center text-sm text-[var(--color-muted-foreground)]">Sin ahorros</p>
    ) : (
      savings.map((s) => (
        <div class="rounded-xl border border-[var(--color-border)] bg-[var(--color-card)] p-4">
          <div class="flex items-start justify-between">
            <div>
              <p class="font-medium">{s.name}</p>
              <p class="text-xs text-[var(--color-muted-foreground)]">{s.categoryName}</p>
            </div>
            <p class="text-lg font-semibold">{formatCLP(s.total)}</p>
          </div>
          <p class="mt-1 text-xs text-[var(--color-muted-foreground)]">Base: {formatCLP(s.baseAmount)}</p>
          <details class="mt-3">
            <summary class="cursor-pointer text-xs text-[var(--color-primary)]">Editar / eliminar</summary>
            <form method="POST" action="/api/actions" class="mt-3 space-y-2">
              <input type="hidden" name="intent" value="update_saving" />
              <input type="hidden" name="returnTo" value="/ahorros" />
              <input type="hidden" name="id" value={s.id} />
              <input name="name" value={s.name} required class="h-9 w-full rounded-lg border border-[var(--color-border)] bg-[var(--color-background)] px-2 text-sm" />
              <select name="categoryId" class="h-9 w-full rounded-lg border border-[var(--color-border)] bg-[var(--color-background)] px-2 text-sm">
                {categories.map((c) => <option value={c.id} selected={c.id === s.categoryId}>{c.name}</option>)}
              </select>
              <input name="baseAmount" value={String(s.baseAmount)} class="h-9 w-full rounded-lg border border-[var(--color-border)] bg-[var(--color-background)] px-2 text-sm" />
              <p class="text-xs text-[var(--color-muted-foreground)]">Editar el monto base no cambia el saldo de tus cuentas.</p>
              <button type="submit" class="h-9 rounded-lg bg-[var(--color-primary)] px-3 text-sm text-[var(--color-primary-foreground)]">Guardar</button>
            </form>
            <form method="POST" action="/api/actions" class="mt-2" onsubmit="return confirm('¿Eliminar ahorro?')">
              <input type="hidden" name="intent" value="delete_saving" />
              <input type="hidden" name="returnTo" value="/ahorros" />
              <input type="hidden" name="id" value={s.id} />
              <button type="submit" class="h-9 rounded-lg border border-red-500 px-3 text-sm text-red-600">Eliminar</button>
            </form>
          </details>
        </div>
      ))
    )}
  </div>

  <div class="rounded-xl border border-[var(--color-border)] bg-[var(--color-card)] p-4">
    <h2 class="mb-3 text-sm font-semibold">Nuevo ahorro</h2>
    {categories.length === 0 ? (
      <p class="text-sm text-[var(--color-muted-foreground)]">Primero crea una <a href="/categorias" class="text-[var(--color-primary)]">categoría</a>.</p>
    ) : (
      <form method="POST" action="/api/actions" class="space-y-3">
        <input type="hidden" name="intent" value="create_saving" />
        <input type="hidden" name="returnTo" value="/ahorros" />
        <input name="name" placeholder="Nombre único" required class="h-10 w-full rounded-lg border border-[var(--color-border)] bg-[var(--color-background)] px-3 text-sm" />
        <select name="categoryId" required class="h-10 w-full rounded-lg border border-[var(--color-border)] bg-[var(--color-background)] px-3 text-sm">
          {categories.map((c) => <option value={c.id}>{c.name}</option>)}
        </select>
        <input name="baseAmount" placeholder="Monto inicial" value="0" class="h-10 w-full rounded-lg border border-[var(--color-border)] bg-[var(--color-background)] px-3 text-sm" />
        <button type="submit" class="h-10 w-full rounded-lg bg-[var(--color-primary)] text-sm font-medium text-[var(--color-primary-foreground)]">Crear</button>
      </form>
    )}
  </div>
</AppLayout>

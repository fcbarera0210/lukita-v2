---
import AppLayout from '../../layouts/AppLayout.astro';
import { MoneyMovementForm } from '../../components/MoneyMovementForm';
import { formatCLP } from '../../lib/clp';
import { formatDate } from '../../lib/dates';
import { listAccounts, listCategories, listSavings, listTransactions } from '../../lib/data';

const user = Astro.locals.user!;
const error = Astro.url.searchParams.get('error');
const type = (Astro.url.searchParams.get('type') || '') as '' | 'ingreso' | 'gasto';
const accountId = Astro.url.searchParams.get('accountId') || '';
const note = Astro.url.searchParams.get('note') || '';
const fromParam = Astro.url.searchParams.get('from');
const toParam = Astro.url.searchParams.get('to');
const editId = Astro.url.searchParams.get('edit');
const showForm = Astro.url.searchParams.get('new') === '1' || Boolean(editId);

const from = fromParam ? new Date(fromParam) : undefined;
const to = toParam ? new Date(toParam) : undefined;

let accounts: Awaited<ReturnType<typeof listAccounts>> = [];
let categories: Awaited<ReturnType<typeof listCategories>> = [];
let savings: Awaited<ReturnType<typeof listSavings>> = [];
let txs: Awaited<ReturnType<typeof listTransactions>> = [];

try {
  [accounts, categories, savings, txs] = await Promise.all([
    listAccounts(user.id),
    listCategories(user.id),
    listSavings(user.id),
    listTransactions(user.id, {
      type: type || undefined,
      accountId: accountId || undefined,
      note: note || undefined,
      from,
      to,
    }),
  ]);
} catch {}

const editing = editId ? txs.find((t) => t.id === editId) : undefined;
const returnQs = Astro.url.search;
---
<AppLayout title="Movimientos · Lukita">
  <div class="mb-4 flex items-center justify-between gap-2">
    <h1 class="text-xl font-semibold">Movimientos</h1>
    <a href="/movimientos?new=1" class="rounded-lg bg-[var(--color-primary)] px-3 py-2 text-sm font-medium text-[var(--color-primary-foreground)]">Nuevo</a>
  </div>
  {error && <p class="mb-3 rounded-lg bg-red-500/10 px-3 py-2 text-sm text-red-600">{error}</p>}

  <form method="GET" class="mb-4 grid grid-cols-2 gap-2 rounded-xl border border-[var(--color-border)] bg-[var(--color-card)] p-3">
    <select name="type" class="h-9 rounded-lg border border-[var(--color-border)] bg-[var(--color-background)] px-2 text-sm">
      <option value="">Todos</option>
      <option value="gasto" selected={type === 'gasto'}>Gasto</option>
      <option value="ingreso" selected={type === 'ingreso'}>Ingreso</option>
    </select>
    <select name="accountId" class="h-9 rounded-lg border border-[var(--color-border)] bg-[var(--color-background)] px-2 text-sm">
      <option value="">Todas las cuentas</option>
      {accounts.map((a) => <option value={a.id} selected={a.id === accountId}>{a.name}</option>)}
    </select>
    <input type="date" name="from" value={fromParam ? fromParam.slice(0, 10) : ''} class="h-9 rounded-lg border border-[var(--color-border)] bg-[var(--color-background)] px-2 text-sm" />
    <input type="date" name="to" value={toParam ? toParam.slice(0, 10) : ''} class="h-9 rounded-lg border border-[var(--color-border)] bg-[var(--color-background)] px-2 text-sm" />
    <input name="note" value={note} placeholder="Buscar nota" class="col-span-2 h-9 rounded-lg border border-[var(--color-border)] bg-[var(--color-background)] px-2 text-sm" />
    <button type="submit" class="col-span-2 h-9 rounded-lg bg-[var(--color-muted)] text-sm font-medium">Filtrar</button>
  </form>

  {showForm && (
    <div class="mb-6 rounded-xl border border-[var(--color-border)] bg-[var(--color-card)] p-4">
      <div class="mb-3 flex items-center justify-between">
        <h2 class="text-sm font-semibold">{editing ? 'Editar movimiento' : 'Nuevo movimiento'}</h2>
        <a href="/movimientos" class="text-xs text-[var(--color-muted-foreground)]">Cerrar</a>
      </div>
      <MoneyMovementForm
        client:load
        accounts={accounts.map((a) => ({ id: a.id, name: a.name }))}
        categories={categories.map((c) => ({ id: c.id, name: c.name }))}
        savings={savings.map((s) => ({ id: s.id, name: s.name, categoryId: s.categoryId }))}
        returnTo="/movimientos"
        initial={editing ? {
          id: editing.id,
          type: editing.type as 'gasto' | 'ingreso',
          amount: editing.amount,
          date: new Date(editing.date).toISOString().slice(0, 10),
          accountId: editing.accountId,
          categoryId: editing.categoryId,
          note: editing.note || '',
          savingsId: editing.savingsId,
        } : undefined}
      />
    </div>
  )}

  <div class="space-y-2">
    {txs.length === 0 ? (
      <p class="rounded-xl border border-dashed border-[var(--color-border)] p-6 text-center text-sm text-[var(--color-muted-foreground)]">No hay movimientos</p>
    ) : (
      txs.map((t) => {
        const account = accounts.find((a) => a.id === t.accountId);
        const category = categories.find((c) => c.id === t.categoryId);
        return (
          <div class="rounded-xl border border-[var(--color-border)] bg-[var(--color-card)] p-3">
            <div class="flex items-start justify-between gap-2">
              <div>
                <p class="text-sm font-medium">{t.note || category?.name || t.type}</p>
                <p class="text-xs text-[var(--color-muted-foreground)]">
                  {account?.name} · {formatDate(new Date(t.date))}
                  {t.savingsId ? ' · ahorro' : ''}
                </p>
              </div>
              <p class={`text-sm font-semibold ${t.type === 'ingreso' ? 'text-green-600' : 'text-red-600'}`}>
                {formatCLP(t.amount)}
              </p>
            </div>
            <div class="mt-2 flex gap-2">
              <a href={`/movimientos?edit=${t.id}`} class="text-xs text-[var(--color-primary)]">Editar</a>
              <form method="POST" action="/api/actions" onsubmit="return confirm('¿Eliminar?')">
                <input type="hidden" name="intent" value="delete_transaction" />
                <input type="hidden" name="returnTo" value="/movimientos" />
                <input type="hidden" name="id" value={t.id} />
                <button type="submit" class="text-xs text-red-600">Eliminar</button>
              </form>
            </div>
          </div>
        );
      })
    )}
  </div>
</AppLayout>

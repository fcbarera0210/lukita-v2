---
import AppLayout from '../../layouts/AppLayout.astro';
import { AccountBalanceToggle, BalanceToggle } from '../../components/BalanceToggle';
import { loadAccountsAndSavings } from '../../lib/data';
import { ACCOUNT_COLORS, ACCOUNT_TYPES, MAX_ACCOUNTS, getAvailableColors, isCreditAccount } from '../../lib/account-colors';
import { calculateAccountGastable, sumBalances } from '../../lib/balances';
import { formatCLP } from '../../lib/clp';
import { AccountFormFields } from '../../components/AccountFormFields';

const user = Astro.locals.user!;
let accounts: Awaited<ReturnType<typeof loadAccountsAndSavings>>['accounts'] = [];
let savingsList: Awaited<ReturnType<typeof loadAccountsAndSavings>>['savings'] = [];
try {
  const loaded = await loadAccountsAndSavings(user.id);
  accounts = loaded.accounts;
  savingsList = loaded.savings;
} catch {}
const usedColors = accounts.map((a) => a.colorId);
const available = getAvailableColors(usedColors);
const canCreate = accounts.length < MAX_ACCOUNTS;

const corrientes = accounts.filter((a) => !isCreditAccount(a.type));
const accountsTotal = sumBalances(corrientes.map((a) => a.balance));
const savingsTotal = sumBalances(savingsList.map((s) => s.total));
const gastable = accountsTotal - savingsTotal;
---
<AppLayout title="Cuentas · Lukita" pageTitle="Cuentas" pageDescription={`${accounts.length}/${MAX_ACCOUNTS} cuentas`}>
  {corrientes.length > 0 && (
    <section class="animate-fade-up surface mb-4 rounded-2xl p-4 sm:p-5">
      <BalanceToggle
        client:load
        accountsTotal={accountsTotal}
        gastable={gastable}
        accountsCount={corrientes.length}
        size="md"
      />
    </section>
  )}

  <div class="grid gap-4 lg:grid-cols-12">
    <div class="animate-fade-up grid gap-3 sm:grid-cols-2 lg:col-span-8 lg:grid-cols-2 xl:grid-cols-3">
      {accounts.length === 0 ? (
        <p class="col-span-full rounded-2xl border border-dashed border-[var(--color-border)] p-6 text-center text-sm text-[var(--color-muted-foreground)]">
          Sin cuentas aún
        </p>
      ) : (
        accounts.map((a) => {
          const color = ACCOUNT_COLORS.find((c) => c.id === a.colorId);
          const credit = isCreditAccount(a.type);
          const accountSavings = savingsList.filter((s) => s.accountId === a.id);
          const accountSavingsTotal = sumBalances(accountSavings.map((s) => s.total));
          const accountGastable = credit ? a.creditAvailable : calculateAccountGastable(a.balance, accountSavingsTotal);
          return (
            <div class={`surface rounded-2xl border-2 p-4 ${color?.class || 'border-[var(--color-border)]'}`}>
              <div class="flex items-start justify-between gap-2">
                <div class="min-w-0">
                  <div class="flex items-center gap-1.5">
                    <p class="truncate font-semibold">{a.name}</p>
                    {a.isFavorite && <span class="text-amber-500" title="Favorita">★</span>}
                  </div>
                  <p class="text-xs text-[var(--color-muted-foreground)]">{ACCOUNT_TYPES.find((t) => t.id === a.type)?.label || a.type}</p>
                </div>
                {credit ? (
                  <div class="text-right">
                    <p class="font-display text-lg font-bold tabular-nums">{formatCLP(a.debt)}</p>
                    <p class="text-[10px] text-[var(--color-muted-foreground)]">Gastado · Cupo {formatCLP(a.creditLimit || 0)}</p>
                    <p class="text-[10px] text-[var(--color-muted-foreground)]">Disp. {formatCLP(a.creditAvailable)}</p>
                  </div>
                ) : (
                  <AccountBalanceToggle client:load balance={a.balance} gastable={accountGastable} />
                )}
              </div>

              <form method="POST" action="/api/actions" class="mt-3">
                <input type="hidden" name="intent" value="set_favorite_account" />
                <input type="hidden" name="returnTo" value="/cuentas" />
                <input type="hidden" name="id" value={a.id} />
                <button
                  type="submit"
                  class={`inline-flex h-8 items-center gap-1 rounded-lg px-2 text-xs font-semibold transition-colors ${
                    a.isFavorite
                      ? 'bg-amber-500/15 text-amber-600'
                      : 'bg-[var(--color-muted)] text-[var(--color-muted-foreground)] hover:text-[var(--color-foreground)]'
                  }`}
                  title={a.isFavorite ? 'Favorita' : 'Marcar como favorita'}
                >
                  {a.isFavorite ? '★ Favorita' : '☆ Favorita'}
                </button>
              </form>

              <details class="mt-3">
                <summary class="cursor-pointer text-xs font-semibold text-[var(--color-primary)]">Editar / eliminar</summary>
                <form method="POST" action="/api/actions" class="mt-3 space-y-2">
                  <input type="hidden" name="intent" value="update_account" />
                  <input type="hidden" name="returnTo" value="/cuentas" />
                  <input type="hidden" name="id" value={a.id} />
                  <input name="name" value={a.name} class="h-9 w-full rounded-xl border border-[var(--color-border)] bg-[var(--color-background)] px-2 text-sm" required />
                  <AccountFormFields
                    client:load
                    mode="edit"
                    initialType={a.type}
                    initialBalance={a.initialBalance}
                    creditLimit={a.creditLimit}
                    colorId={a.colorId}
                    colorOptions={ACCOUNT_COLORS.filter((c) => c.id === a.colorId || !usedColors.includes(c.id)).map((c) => ({ id: c.id, name: c.name }))}
                  />
                  <button type="submit" class="h-9 rounded-xl bg-[var(--color-primary)] px-3 text-sm font-semibold text-[var(--color-primary-foreground)]">Guardar</button>
                </form>
                <form method="POST" action="/api/actions" class="mt-2" onsubmit="return confirm('¿Eliminar cuenta?')">
                  <input type="hidden" name="intent" value="delete_account" />
                  <input type="hidden" name="returnTo" value="/cuentas" />
                  <input type="hidden" name="id" value={a.id} />
                  <button type="submit" class="h-9 rounded-xl border border-red-500 px-3 text-sm font-semibold text-red-600">Eliminar</button>
                </form>
              </details>
            </div>
          );
        })
      )}
    </div>

    <aside class="animate-fade-up-delay-1 lg:col-span-4">
      {canCreate ? (
        <div class="surface sticky top-24 rounded-2xl p-4">
          <h2 class="font-display mb-3 text-base font-bold">Nueva cuenta</h2>
          <form method="POST" action="/api/actions" class="space-y-3">
            <input type="hidden" name="intent" value="create_account" />
            <input type="hidden" name="returnTo" value="/cuentas" />
            <input name="name" placeholder="Nombre" required class="h-10 w-full rounded-xl border border-[var(--color-border)] bg-[var(--color-background)] px-3 text-sm" />
            <AccountFormFields
              client:load
              mode="create"
              colorOptions={available.map((c) => ({ id: c.id, name: c.name }))}
            />
            <button type="submit" class="brand-gradient h-10 w-full rounded-xl text-sm font-semibold text-[#163038]">Crear</button>
          </form>
        </div>
      ) : (
        <p class="surface rounded-2xl p-4 text-sm text-[var(--color-muted-foreground)]">Alcanzaste el máximo de {MAX_ACCOUNTS} cuentas.</p>
      )}
    </aside>
  </div>
</AppLayout>

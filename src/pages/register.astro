---
import BaseLayout from '../layouts/BaseLayout.astro';

const error = Astro.url.searchParams.get('error');
---
<BaseLayout title="Registro · Lukita">
  <div class="mx-auto flex min-h-dvh max-w-md flex-col justify-center px-4 py-10">
    <div class="mb-8 text-center">
      <img src="/logo-lukita.svg" alt="Lukita" class="mx-auto h-10" />
      <p class="mt-3 text-sm text-[var(--color-muted-foreground)]">Crea tu cuenta</p>
    </div>
    <div class="rounded-xl border border-[var(--color-border)] bg-[var(--color-card)] p-6 shadow-sm">
      {error && (
        <p class="mb-4 rounded-lg bg-red-500/10 px-3 py-2 text-sm text-red-600 dark:text-red-400">{error}</p>
      )}
      <form method="POST" action="/api/auth" class="space-y-4">
        <input type="hidden" name="intent" value="register" />
        <div>
          <label class="mb-1.5 block text-sm font-medium" for="email">Email</label>
          <input id="email" name="email" type="email" required class="flex h-10 w-full rounded-lg border border-[var(--color-border)] bg-[var(--color-background)] px-3 text-sm" />
        </div>
        <div>
          <label class="mb-1.5 block text-sm font-medium" for="password">Contraseña (mín. 6)</label>
          <input id="password" name="password" type="password" minlength="6" required class="flex h-10 w-full rounded-lg border border-[var(--color-border)] bg-[var(--color-background)] px-3 text-sm" />
        </div>
        <button type="submit" class="brand-gradient h-10 w-full rounded-lg text-sm font-semibold text-[#163038]">Crear cuenta</button>
      </form>
      <p class="mt-4 text-center text-sm text-[var(--color-muted-foreground)]">
        ¿Ya tienes cuenta? <a href="/login" class="text-[var(--color-primary)]">Inicia sesión</a>
      </p>
    </div>
  </div>
</BaseLayout>

---
import AppLayout from '../../layouts/AppLayout.astro';
import { listCategories } from '../../lib/data';
import { categoryEmoji, DEFAULT_CATEGORY_EMOJI } from '../../lib/category-emoji';

const user = Astro.locals.user!;
let categories: Awaited<ReturnType<typeof listCategories>> = [];
try {
  categories = await listCategories(user.id);
} catch {}
---
<AppLayout title="Categorías · Lukita" pageTitle="Categorías" pageDescription="Universales para ingresos y gastos">
  <div class="grid gap-4 lg:grid-cols-12">
    <div class="animate-fade-up grid gap-3 sm:grid-cols-2 lg:col-span-8 lg:grid-cols-2 xl:grid-cols-3">
      {categories.length === 0 ? (
        <p class="col-span-full rounded-2xl border border-dashed border-[var(--color-border)] p-6 text-center text-sm text-[var(--color-muted-foreground)]">Sin categorías</p>
      ) : (
        categories.map((c) => {
          const emoji = categoryEmoji(c.icon);
          return (
            <div class="surface rounded-2xl p-4">
              <div class="flex items-center gap-3">
                <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-[var(--color-muted)] text-2xl" aria-hidden="true">
                  {emoji}
                </span>
                <div class="min-w-0">
                  <p class="truncate font-semibold">{c.name}</p>
                  <p class="text-xs text-[var(--color-muted-foreground)]">Toca editar para cambiar el emoji</p>
                </div>
              </div>
              <details class="mt-3">
                <summary class="cursor-pointer text-xs font-semibold text-[var(--color-primary)]">Editar / eliminar</summary>
                <form method="POST" action="/api/actions" class="mt-3 space-y-2">
                  <input type="hidden" name="intent" value="update_category" />
                  <input type="hidden" name="returnTo" value="/categorias" />
                  <input type="hidden" name="id" value={c.id} />
                  <div class="flex items-center gap-2">
                    <input
                      id={`icon-${c.id}`}
                      name="icon"
                      value={emoji}
                      maxlength="8"
                      inputmode="text"
                      autocomplete="off"
                      aria-label="Emoji"
                      title="Emoji"
                      class="h-9 w-9 shrink-0 rounded-xl border border-[var(--color-border)] bg-[var(--color-background)] text-center text-lg"
                    />
                    <input name="name" value={c.name} required class="h-9 min-w-0 flex-1 rounded-xl border border-[var(--color-border)] bg-[var(--color-background)] px-2 text-sm" />
                  </div>
                  <button type="submit" class="h-9 rounded-xl bg-[var(--color-primary)] px-3 text-sm font-semibold text-[var(--color-primary-foreground)]">Guardar</button>
                </form>
                <form method="POST" action="/api/actions" class="mt-2" onsubmit="return confirm('¿Eliminar?')">
                  <input type="hidden" name="intent" value="delete_category" />
                  <input type="hidden" name="returnTo" value="/categorias" />
                  <input type="hidden" name="id" value={c.id} />
                  <button type="submit" class="h-9 rounded-xl border border-red-500 px-3 text-sm font-semibold text-red-600">Eliminar</button>
                </form>
              </details>
            </div>
          );
        })
      )}
    </div>

    <aside class="animate-fade-up-delay-1 lg:col-span-4">
      <div class="surface sticky top-24 rounded-2xl p-4">
        <h2 class="font-display mb-3 text-base font-bold">Nueva categoría</h2>
        <form method="POST" action="/api/actions" class="space-y-3">
          <input type="hidden" name="intent" value="create_category" />
          <input type="hidden" name="returnTo" value="/categorias" />
          <div>
            <label class="mb-1 block text-sm font-medium" for="new-name">Nombre</label>
            <div class="flex items-center gap-2">
              <input
                id="new-icon"
                name="icon"
                value={DEFAULT_CATEGORY_EMOJI}
                maxlength="8"
                inputmode="text"
                autocomplete="off"
                aria-label="Emoji"
                title="Emoji (Win + .)"
                placeholder="🧹"
                class="h-10 w-10 shrink-0 rounded-xl border border-[var(--color-border)] bg-[var(--color-background)] text-center text-lg"
              />
              <input id="new-name" name="name" placeholder="Ej. Supermercado" required class="h-10 min-w-0 flex-1 rounded-xl border border-[var(--color-border)] bg-[var(--color-background)] px-3 text-sm" />
            </div>
            <p class="mt-1.5 text-xs text-[var(--color-muted-foreground)]">
              Emoji con el teclado: <kbd class="rounded bg-[var(--color-muted)] px-1">Win</kbd> + <kbd class="rounded bg-[var(--color-muted)] px-1">.</kbd>
            </p>
          </div>
          <button type="submit" class="brand-gradient h-10 w-full rounded-xl text-sm font-semibold text-[#163038]">Crear</button>
        </form>
      </div>
    </aside>
  </div>
</AppLayout>

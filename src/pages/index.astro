---
import AppLayout from '../layouts/AppLayout.astro';
import { AccountBalanceToggle } from '../components/BalanceToggle';
import { AccountTabs } from '../components/AccountTabs';
import { CreditPaymentForm } from '../components/CreditPaymentForm';
import { InstallmentPurchaseForm } from '../components/InstallmentPurchaseForm';
import { InstallmentsPanel } from '../components/InstallmentsPanel';
import { MoneyMovementForm } from '../components/MoneyMovementForm';
import { formatCLP } from '../lib/clp';
import { formatDate, formatPeriodLabel, getPeriodFromCutoff, shiftPeriod } from '../lib/dates';
import { listAccounts, listCategories, listInstallments, listSavings, listTransactions, periodSummary } from '../lib/data';
import { calculateAccountGastable, sumBalances } from '../lib/balances';
import { getColorById, isCreditAccount, isCheckingAccount } from '../lib/account-colors';

const user = Astro.locals.user!;
const pivotParam = Astro.url.searchParams.get('p');
const accountParam = Astro.url.searchParams.get('account');
const actionParam = Astro.url.searchParams.get('action');
const formError = Astro.url.searchParams.get('error') || '';
const openAction = actionParam === 'gasto' || actionParam === 'ingreso' ? actionParam : null;
const pivot = pivotParam ? new Date(pivotParam) : new Date();
const [periodStart, periodEnd] = getPeriodFromCutoff(pivot, user.monthCutoffDay);
const prevPivot = shiftPeriod(pivot, user.monthCutoffDay, -1);
const nextPivot = shiftPeriod(pivot, user.monthCutoffDay, 1);

let accounts: Awaited<ReturnType<typeof listAccounts>> = [];
let categories: Awaited<ReturnType<typeof listCategories>> = [];
let savingsList: Awaited<ReturnType<typeof listSavings>> = [];
let installmentsList: Awaited<ReturnType<typeof listInstallments>> = [];
let summary = { income: 0, expense: 0, transactions: [] as Awaited<ReturnType<typeof listTransactions>> };
let recent: Awaited<ReturnType<typeof listTransactions>> = [];
let loadError = '';

try {
  accounts = await listAccounts(user.id);
  categories = await listCategories(user.id);
} catch (e) {
  loadError = e instanceof Error ? e.message : 'Error al cargar datos';
}

const activeAccount =
  accounts.find((a) => a.id === accountParam) ||
  accounts.find((a) => a.isFavorite) ||
  accounts[0] ||
  null;

const isCredit = activeAccount ? isCreditAccount(activeAccount.type) : false;
const checkingAccounts = accounts.filter((a) => isCheckingAccount(a.type));

if (activeAccount) {
  try {
    savingsList = isCredit ? [] : await listSavings(user.id, { accountId: activeAccount.id });
    summary = await periodSummary(user.id, periodStart, periodEnd, activeAccount.id);
    recent = await listTransactions(user.id, {
      accountId: activeAccount.id,
      limit: user.dashboardRecentCount,
    });
    if (isCredit) {
      installmentsList = await listInstallments(user.id, { creditAccountId: activeAccount.id });
    }
  } catch (e) {
    loadError = e instanceof Error ? e.message : 'Error al cargar datos';
  }
}

const savingsTotal = sumBalances(savingsList.map((s) => s.total));
const accountGastable = activeAccount && !isCredit
  ? calculateAccountGastable(activeAccount.balance, savingsTotal)
  : 0;

const fromIso = periodStart.toISOString();
const toIso = periodEnd.toISOString();
const homeReturn = activeAccount
  ? `/?account=${activeAccount.id}${pivotParam ? `&p=${encodeURIComponent(pivotParam)}` : ''}`
  : '/';
const gastoReturn = activeAccount
  ? `/?account=${activeAccount.id}&action=gasto${pivotParam ? `&p=${encodeURIComponent(pivotParam)}` : ''}`
  : '/?action=gasto';
const ingresoReturn = activeAccount
  ? `/?account=${activeAccount.id}&action=ingreso${pivotParam ? `&p=${encodeURIComponent(pivotParam)}` : ''}`
  : '/?action=ingreso';

const tabAccounts = accounts.map((a) => ({
  id: a.id,
  name: a.name,
  type: a.type,
  isFavorite: a.isFavorite,
  colorValue: getColorById(a.colorId)?.value,
}));

const formAccounts = accounts.map((a) => ({ id: a.id, name: a.name, type: a.type }));
const formCategories = categories.map((c) => ({ id: c.id, name: c.name }));
const formSavings = savingsList.map((s) => ({ id: s.id, name: s.name, accountId: s.accountId }));

const pendingInstallments = installmentsList.filter((i) => i.status === 'pending');
const periodPending = pendingInstallments.filter((i) => {
  const d = new Date(i.dueDate);
  return d >= periodStart && d <= periodEnd;
});
const overdueCount = periodPending.filter((i) => i.overdue).length;

const periodInstallmentRows = periodPending.map((i) => ({
  id: i.id,
  sequence: i.sequence,
  dueDate: new Date(i.dueDate).toISOString(),
  plannedAmount: i.plannedAmount,
  status: i.status,
  overdue: i.overdue,
  installmentCount: i.installmentCount,
  planNote: i.planNote,
  categoryName: i.categoryName,
}));
---
<AppLayout title="Inicio · Lukita" pageTitle="Inicio" pageDescription={activeAccount ? activeAccount.name : 'Resumen de tu plata'}>
  {loadError && (
    <p class="mb-4 rounded-xl border border-amber-500/30 bg-amber-500/10 px-3 py-2 text-sm text-amber-700 dark:text-amber-300">
      {loadError}. Configura DATABASE_URL y ejecuta npm run db:push.
    </p>
  )}

  {accounts.length === 0 ? (
    <p class="rounded-2xl border border-dashed border-[var(--color-border)] p-8 text-center text-sm text-[var(--color-muted-foreground)]">
      Crea tu primera cuenta en <a href="/cuentas" class="font-semibold text-[var(--color-primary)]">Cuentas</a>.
    </p>
  ) : (
    <>
      <AccountTabs
        client:load
        accounts={tabAccounts}
        activeId={activeAccount!.id}
        periodParam={pivotParam || undefined}
      />

      <div class="grid gap-4 lg:grid-cols-12">
        <section class="animate-fade-up surface rounded-2xl p-5 lg:col-span-5">
          {isCredit ? (
            <div>
              <p class="text-sm text-[var(--color-muted-foreground)]">Disponible</p>
              <p class="font-display mt-1 text-4xl font-bold tracking-tight tabular-nums">{formatCLP(activeAccount!.creditAvailable)}</p>
              <div class="mt-4 grid grid-cols-2 gap-3">
                <div class="rounded-xl bg-[var(--color-muted)]/70 p-3">
                  <p class="text-xs text-[var(--color-muted-foreground)]">Cupo</p>
                  <p class="mt-1 font-semibold tabular-nums">{formatCLP(activeAccount!.creditLimit || 0)}</p>
                </div>
                <div class="rounded-xl bg-[var(--color-muted)]/70 p-3">
                  <p class="text-xs text-[var(--color-muted-foreground)]">Gastado</p>
                  <p class="mt-1 font-semibold tabular-nums">{formatCLP(activeAccount!.debt)}</p>
                </div>
              </div>
              {overdueCount > 0 && (
                <p class="mt-3 rounded-lg border border-amber-500/30 bg-amber-500/10 px-3 py-2 text-xs font-medium text-amber-700 dark:text-amber-300">
                  {overdueCount} cuota{overdueCount === 1 ? '' : 's'} vencida{overdueCount === 1 ? '' : 's'} por revisar
                </p>
              )}
            </div>
          ) : (
            <AccountBalanceToggle
              client:load
              balance={activeAccount!.balance}
              gastable={accountGastable}
              size="lg"
              className="text-left"
            />
          )}
        </section>

        <section class="animate-fade-up-delay-1 surface rounded-2xl p-5 lg:col-span-7">
          <div class="mb-4 flex items-center justify-between gap-2">
            <a href={`/?account=${activeAccount!.id}&p=${prevPivot.toISOString()}`} class="rounded-xl p-2 transition-colors hover:bg-[var(--color-muted)]" aria-label="Periodo anterior">‹</a>
            <div class="text-center">
              <p class="text-sm font-semibold">Periodo</p>
              <p class="text-xs text-[var(--color-muted-foreground)]">{formatPeriodLabel(periodStart, periodEnd)}</p>
            </div>
            <a href={`/?account=${activeAccount!.id}&p=${nextPivot.toISOString()}`} class="rounded-xl p-2 transition-colors hover:bg-[var(--color-muted)]" aria-label="Periodo siguiente">›</a>
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div class="rounded-xl bg-[var(--color-muted)]/70 p-4">
              <p class="text-xs text-[var(--color-muted-foreground)]">Ingresos</p>
              <p class="mt-1 text-lg font-semibold text-green-600 dark:text-green-400">{formatCLP(summary.income)}</p>
            </div>
            <div class="rounded-xl bg-[var(--color-muted)]/70 p-4">
              <p class="text-xs text-[var(--color-muted-foreground)]">Gastos</p>
              <p class="mt-1 text-lg font-semibold text-red-600 dark:text-red-400">{formatCLP(summary.expense)}</p>
            </div>
          </div>
        </section>

        <section class="animate-fade-up-delay-2 lg:col-span-8">
          <div class="mb-3 flex items-center justify-between">
            <h2 class="font-display text-base font-bold">Últimos movimientos</h2>
            <a
              href={`/movimientos?accountId=${activeAccount!.id}&from=${encodeURIComponent(fromIso)}&to=${encodeURIComponent(toIso)}`}
              class="text-xs font-semibold text-[var(--color-primary)]"
            >
              Ver más
            </a>
          </div>
          <div class="surface overflow-hidden rounded-2xl">
            {recent.length === 0 ? (
              <p class="p-5 text-sm text-[var(--color-muted-foreground)]">
                Sin movimientos aún.
              </p>
            ) : (
              <ul class="divide-y divide-[var(--color-border)]">
                {recent.map((t) => (
                  <li class="flex items-center justify-between gap-3 px-4 py-3 transition-colors hover:bg-[var(--color-muted)]/40">
                    <div class="min-w-0">
                      <p class="truncate text-sm font-medium">{t.note || t.type}</p>
                      <p class="text-xs text-[var(--color-muted-foreground)]">{formatDate(new Date(t.date))}</p>
                    </div>
                    <p class={`shrink-0 text-sm font-semibold ${t.type === 'ingreso' ? 'text-green-600 dark:text-green-400' : 'text-red-600 dark:text-red-400'}`}>
                      {formatCLP(t.amount)}
                    </p>
                  </li>
                ))}
              </ul>
            )}
          </div>
        </section>

        {isCredit ? (
          <section class="animate-fade-up-delay-3 space-y-4 lg:col-span-4">
            <div>
              <h2 class="font-display mb-3 text-base font-bold">Cuotas del periodo</h2>
              <div class="surface rounded-2xl p-4">
                {periodPending.length === 0 ? (
                  <p class="text-sm text-[var(--color-muted-foreground)]">Sin cuotas pendientes en este periodo.</p>
                ) : (
                  <ul class="space-y-2">
                    {periodPending.map((i) => (
                      <li class={`flex items-center justify-between gap-2 text-sm ${i.overdue ? 'text-amber-700 dark:text-amber-300' : ''}`}>
                        <span class="truncate">
                          #{i.sequence}/{i.installmentCount}
                          {i.overdue ? ' · vencida' : ''}
                          {i.planNote ? ` · ${i.planNote}` : ''}
                        </span>
                        <span class="font-semibold tabular-nums">{formatCLP(i.plannedAmount)}</span>
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </div>

            <details class="surface rounded-2xl p-4">
              <summary class="cursor-pointer font-display text-sm font-bold">Abonar a la deuda</summary>
              <div class="mt-3">
                <CreditPaymentForm
                  client:load
                  creditAccountId={activeAccount!.id}
                  checkingAccounts={checkingAccounts.map((a) => ({ id: a.id, name: a.name }))}
                  currentDebt={activeAccount!.debt}
                  returnTo={homeReturn}
                />
              </div>
            </details>

            <details class="surface rounded-2xl p-4" open={openAction === 'gasto'}>
              <summary class="cursor-pointer font-display text-sm font-bold">Nuevo gasto</summary>
              <div class="mt-3">
                <MoneyMovementForm
                  client:load
                  accounts={formAccounts}
                  categories={formCategories}
                  savings={[]}
                  lockedType="gasto"
                  hideAccountSelect
                  returnTo={gastoReturn}
                  errorMessage={openAction === 'gasto' ? formError || undefined : undefined}
                  initial={{ accountId: activeAccount!.id, type: 'gasto' }}
                />
              </div>
            </details>

            <details class="surface rounded-2xl p-4">
              <summary class="cursor-pointer font-display text-sm font-bold">Compra en cuotas</summary>
              <div class="mt-3">
                <InstallmentPurchaseForm
                  client:load
                  creditAccountId={activeAccount!.id}
                  categories={categories.map((c) => ({ id: c.id, name: c.name }))}
                  returnTo={homeReturn}
                />
              </div>
            </details>

            <details class="surface rounded-2xl p-4" open={periodPending.length > 0}>
              <summary class="cursor-pointer font-display text-sm font-bold">Pagar una cuota</summary>
              <div class="mt-3">
                <InstallmentsPanel
                  client:load
                  mode="list"
                  installments={periodInstallmentRows}
                  checkingAccounts={checkingAccounts.map((a) => ({ id: a.id, name: a.name }))}
                  returnTo={homeReturn}
                />
              </div>
            </details>

            <details class="surface rounded-2xl p-4" open={periodPending.length > 1}>
              <summary class="cursor-pointer font-display text-sm font-bold">
                Pagar cuotas del mes ({periodPending.length})
              </summary>
              <div class="mt-3">
                <InstallmentsPanel
                  client:load
                  mode="pay-month"
                  installments={periodInstallmentRows}
                  checkingAccounts={checkingAccounts.map((a) => ({ id: a.id, name: a.name }))}
                  returnTo={homeReturn}
                />
              </div>
            </details>
          </section>
        ) : (
          <section class="animate-fade-up-delay-3 space-y-4 lg:col-span-4">
            <div>
              <div class="mb-3 flex items-center justify-between">
                <h2 class="font-display text-base font-bold">Ahorros</h2>
                <a href={`/ahorros?accountId=${activeAccount!.id}`} class="text-xs font-semibold text-[var(--color-primary)]">Ver todos</a>
              </div>
              <div class="surface rounded-2xl p-4">
                {savingsList.length === 0 ? (
                  <p class="text-sm text-[var(--color-muted-foreground)]">
                    Aún no tienes ahorros en esta cuenta. <a href={`/ahorros?accountId=${activeAccount!.id}`} class="text-[var(--color-primary)]">Crear</a>
                  </p>
                ) : (
                  <ul class="space-y-3">
                    {savingsList.map((s) => (
                      <li class="flex items-center justify-between gap-2 text-sm">
                        <span class="truncate">{s.name}</span>
                        <span class="font-semibold tabular-nums">{formatCLP(s.total)}</span>
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </div>

            <details class="surface rounded-2xl p-4" open={openAction === 'gasto'}>
              <summary class="cursor-pointer font-display text-sm font-bold">Nuevo gasto</summary>
              <div class="mt-3">
                <MoneyMovementForm
                  client:load
                  accounts={formAccounts}
                  categories={formCategories}
                  savings={formSavings}
                  lockedType="gasto"
                  hideAccountSelect
                  returnTo={gastoReturn}
                  errorMessage={openAction === 'gasto' ? formError || undefined : undefined}
                  initial={{ accountId: activeAccount!.id, type: 'gasto' }}
                />
              </div>
            </details>

            <details class="surface rounded-2xl p-4" open={openAction === 'ingreso'}>
              <summary class="cursor-pointer font-display text-sm font-bold">Nuevo ingreso</summary>
              <div class="mt-3">
                <MoneyMovementForm
                  client:load
                  accounts={formAccounts}
                  categories={formCategories}
                  savings={formSavings}
                  lockedType="ingreso"
                  hideAccountSelect
                  returnTo={ingresoReturn}
                  errorMessage={openAction === 'ingreso' ? formError || undefined : undefined}
                  initial={{ accountId: activeAccount!.id, type: 'ingreso' }}
                />
              </div>
            </details>
          </section>
        )}
      </div>
    </>
  )}
</AppLayout>

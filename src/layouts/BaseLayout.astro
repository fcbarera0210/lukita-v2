---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { Toaster } from '../components/Toaster';
import { FormPending } from '../components/FormPending';

interface Props {
  title?: string;
  user?: { email: string; theme: string } | null;
}

const { title = 'Lukita', user = null } = Astro.props;
---
<!doctype html>
<html lang="es" class={user?.theme === 'light' ? '' : 'dark'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#00C6DB" />
    <link rel="icon" type="image/svg+xml" href="/logo-icono.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&family=Syne:wght@600;700;800&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <ClientRouter />
    <script is:inline define:vars={{ theme: user?.theme || 'dark' }}>
      (function () {
        const root = document.documentElement;
        if (theme === 'system') {
          const dark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          root.classList.toggle('dark', dark);
        } else {
          root.classList.toggle('dark', theme !== 'light');
        }
      })();
    </script>
  </head>
  <body class="min-h-dvh text-[var(--color-foreground)] antialiased">
    <slot />
    <Toaster client:load />
    <FormPending client:load />
  </body>
</html>
